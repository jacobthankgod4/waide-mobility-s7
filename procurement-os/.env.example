# Waide Procurement OS — environment
# Copy to .env.local and fill in. Never commit .env.local.

# ---- AgentMail -------------------------------------------------------------
# Create an account at https://console.agentmail.to, then create an API key.
# The desk inbox is created on first send with a stable client id, so this is
# only needed to send or read mail.
AGENTMAIL_API_KEY=

# Svix signing secret of the webhook you register against
#   https://<your-host>/api/agentmail/webhook
# Subscribe it to: message.received, message.sent, message.delivered,
# message.bounced, message.complained, message.rejected, domain.verified.
AGENTMAIL_WEBHOOK_SECRET=

# Optional: use an address that already exists in the account instead of
# letting the desk create one. Accepts an inbox id or its email address.
AGENTMAIL_INBOX=

# ---- Database (optional) ---------------------------------------------------
# The console runs on data/runtime/*.json with no database. Setting DATABASE_URL
# is what the PostgreSQL-backed repository reads; leave empty to keep the file
# store. See docs/ARCHITECTURE.md for the persistence boundary.
DATABASE_URL=
