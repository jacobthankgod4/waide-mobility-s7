# Copy this file to .env and fill in your actual API keys
# DO NOT commit .env to git

# OpenRouter API Keys (for AI content generation)
OPENROUTER_API_KEY_1=your_openrouter_api_key_1_here
OPENROUTER_API_KEY_2=your_openrouter_api_key_2_here
OPENROUTER_API_KEY_3=your_openrouter_api_key_3_here

# Enquiry endpoint (/api/enquiry): server-side only, never exposed to the browser.
# Set at least one route or the endpoint answers 503 and the page falls back to email.

# Supabase project URL and service role key (storage of enquiry records).
# Run supabase/enquiries.sql first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Brevo API key: preferred delivery route for the contact form. The sender in
# ENQUIRY_FROM must be verified in Brevo (Senders, Domains & IPs).
BREVO_API_KEY=your_brevo_api_key_here

# Brevo SMTP relay (port 587). Kept for mail clients and other tools; the
# serverless endpoint uses the HTTPS API above because it cannot open SMTP.
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_smtp_login_here
BREVO_SMTP_KEY=your_smtp_key_here

# Resend API key (fallback notification route when Brevo is not configured)
RESEND_API_KEY=your_resend_api_key_here
ENQUIRY_TO=sales@waidemobility.com
ENQUIRY_FROM=Stephanie Ezedunukwe <sales@waidemobility.com>

# AgentMail inbox for the enquiry agent: an acknowledgement after a stored
# enquiry and replies handled by POST /api/agent-mail-webhook.
# Key: https://console.agentmail.to. Point a message.received webhook at
# https://<site>/api/agent-mail-webhook and copy its signing secret.
# Keep both empty in git; set them in the hosting environment.
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
# Optional: send acknowledgements from an existing inbox instead of creating one.
AGENTMAIL_INBOX=
